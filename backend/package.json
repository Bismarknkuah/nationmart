{
  "name": "nationmart-backend",
  "description": "NationMart \u2013 Backend API",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node src/scripts/seed.ts",
    "create-admin": "ts-node src/scripts/createSuperAdmin.ts",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand",
    "db:deploy": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ../postgres/001_money_core.sql -f ../postgres/002_commerce_core.sql -f ../postgres/003_platform.sql -f ../postgres/004_users_identity.sql -f ../postgres/005_store_product_extras.sql -f ../postgres/006_disputes.sql -f ../postgres/007_search.sql -f ../postgres/008_payment_methods.sql",
    "db:reset": "psql \"$DATABASE_URL\" -c \"DROP SCHEMA public CASCADE; CREATE SCHEMA public;\" && npm run db:deploy"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.41",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.3",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/streamifier": "^0.1.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "nodemon": "^3.0.2",
    "pdfkit": "^0.15.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "streamifier": "^0.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5"
  }
}